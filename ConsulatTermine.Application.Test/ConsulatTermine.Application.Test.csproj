<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsulatTermine.Application\ConsulatTermine.Application.csproj" />
    <ProjectReference Include="..\ConsulatTermine.Domain\ConsulatTermine.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>


  <PropertyGroup>
    <!--
      CA1707 verbietet Unterstriche in Membernamen. Testnamen folgen bewusst dem
      Schema Ausgangslage_Aktion_Ergebnis, das harness/profile.md Abschnitt 13
      ausdrücklich vorgibt. Die Ausnahme gilt nur für Testprojekte.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>

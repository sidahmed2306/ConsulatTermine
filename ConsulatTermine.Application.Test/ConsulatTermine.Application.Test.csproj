<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsulatTermine.Application\ConsulatTermine.Application.csproj" />
    <ProjectReference Include="..\ConsulatTermine.Domain\ConsulatTermine.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>


  <PropertyGroup>
    <!--
      Zwei Benennungsregeln gelten für Testmethoden bewusst nicht. Die Ausnahme ist
      auf Testprojekte begrenzt; im Anwendungscode bleiben beide Regeln in Kraft.

      CA1707 verbietet Unterstriche in Membernamen. IDE1006 verlangt für asynchrone
      Methoden das Suffix "Async". Testnamen folgen stattdessen dem Schema
      Ausgangslage_Aktion_Ergebnis, das harness/profile.md Abschnitt 13 ausdrücklich
      vorgibt und dessen eigenes Beispiel ebenfalls nicht auf "Async" endet. Ein
      erzwungenes Suffix würde jeden Testnamen unleserlich machen, ohne dass es einen
      Aufrufer gäbe, dem es hülfe.
    -->
    <NoWarn>$(NoWarn);CA1707;IDE1006</NoWarn>
  </PropertyGroup>

</Project>

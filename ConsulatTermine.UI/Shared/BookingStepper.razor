@inject NavigationManager Navigation
@inject IStringLocalizer<BookingTexts> Texts

<nav class="booking-stepper mb-6" aria-label="@Texts["Stepper.Aria"]">
    <ol class="booking-stepper-inner">
        @for (var index = 0; index < Steps.Length; index++)
        {
            var step = Steps[index];
            var isCompleted = ActiveStep > index;
            var isActive = ActiveStep == index;
            var isReachable = index <= ActiveStep;
            var stepNumber = index + 1;
            var label = Texts[step.LabelKey];
            var stepIndex = index;

            <li class="booking-step @(isActive ? "active" : "") @(isCompleted ? "completed" : "") @(isReachable ? "clickable" : "")"
                aria-current="@(isActive ? "step" : null)">

                @* Button statt div: ein Schritt ist eine Aktion und muss mit der
                   Tastatur erreichbar und ausloesbar sein. Nicht erreichte Schritte
                   sind deaktiviert statt nur optisch anders. *@
                <button type="button"
                        class="booking-step-button"
                        disabled="@(!isReachable)"
                        aria-label="@Texts["Stepper.Step", stepNumber, Steps.Length, label]"
                        @onclick="@(() => GoToStep(stepIndex))">

                    <span class="booking-step-label">@label</span>

                    <span class="booking-step-circle" aria-hidden="true">
                        @if (isCompleted && !isActive)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="step-check" />
                        }
                        else
                        {
                            @stepNumber
                        }
                    </span>
                </button>
            </li>

            @if (index < Steps.Length - 1)
            {
                <li class="booking-step-connector" aria-hidden="true"></li>
            }
        }
    </ol>
</nav>

@code {
    /// <summary>
    /// Nullbasierter Index des Schritts, auf dem der Buchende gerade steht.
    /// </summary>
    [Parameter] public int ActiveStep { get; set; }

    private static readonly (string LabelKey, string Url)[] Steps =
    [
        ("Stepper.Service", "/services"),
        ("Stepper.Slot", "/appointment"),
        ("Stepper.Form", "/appointment-form"),
        ("Stepper.Confirmation", "/appointment-confirmation")
    ];

    private void GoToStep(int stepIndex)
    {
        // Vorwaerts wird nur ueber den Ablauf selbst gesprungen: ein spaeterer Schritt
        // setzt Angaben voraus, die davor entstehen.
        if (stepIndex > ActiveStep)
        {
            return;
        }

        Navigation.NavigateTo(Steps[stepIndex].Url);
    }
}

@inherits LayoutComponentBase

@using ConsulatTermine.UI.Theme

@inject IStringLocalizer<CommonTexts> Texts

<MudThemeProvider Theme="AlgeriaTheme.DefaultTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@*
    MudRTLProvider dreht die Schreibrichtung der gesamten Komponentenbibliothek.
    Ohne ihn bliebe die Oberflaeche auf Arabisch von links nach rechts angeordnet,
    obwohl der Text von rechts nach links gelesen wird.
*@
<MudRTLProvider RightToLeft="@_language.IsRightToLeft">

<MudLayout>

    <MudAppBar Elevation="0" Color="Color.Primary" Class="consulate-appbar">

        <div class="consulate-appbar-inner">

            <div class="consulate-brand">
                <img src="images/Alg_Logo.png"
                     alt="@Texts["App.LogoAlt"]"
                     class="consulate-logo" />

                <span class="consulate-title">@Texts["App.Name"]</span>
            </div>

            <LanguageSwitcher />

        </div>

    </MudAppBar>

    @* Die Sichtbarkeit der Navigation steuert nur die Benutzerfuehrung. Jede Seite
       prueft zusaetzlich per [Authorize], jeder Anwendungsfall serverseitig erneut. *@
    <AuthorizeView Policy="@AuthorizationPolicies.MitarbeiterZugriff">
        <Authorized>
            <MudDrawer Open="true"
                       Variant="DrawerVariant.Persistent"
                       Anchor="@(_language.IsRightToLeft ? Anchor.Right : Anchor.Left)"
                       Width="260px">

                <NavMenu />

            </MudDrawer>

            @* Logische Randangabe statt margin-left: sie folgt der Schreibrichtung und
               laesst auf Arabisch Platz fuer die dann rechts stehende Navigation. *@
            <MudMainContent Style="margin-top:88px; margin-inline-start:260px;">
                @Body
            </MudMainContent>
        </Authorized>

        <NotAuthorized>
            <MudMainContent Style="margin-top:88px;">
                @Body
            </MudMainContent>
        </NotAuthorized>
    </AuthorizeView>

</MudLayout>

</MudRTLProvider>

@code {
    private SupportedLanguage _language = SupportedLanguages.Default;

    protected override void OnInitialized()
    {
        // Die Kultur setzt die Request-Lokalisierung zu Beginn der Anfrage; Blazor Server
        // uebernimmt sie fuer die Lebensdauer des Kreises.
        _language = SupportedLanguages.Resolve(CultureInfo.CurrentUICulture.Name);
    }
}

@inject IStringLocalizer<CommonTexts> Texts

@* Die Sichtbarkeit der Einträge steuert die Benutzerführung. Sie ist keine
   Sicherheitsgrenze: jede Seite prüft zusätzlich per [Authorize], und jeder
   Anwendungsfall prüft serverseitig erneut. Siehe harness/security.md Abschnitt 4. *@

<MudNavMenu aria-label="@Texts["Nav.Menu"]">

    <AuthorizeView Policy="@AuthorizationPolicies.MitarbeiterZugriff">
        <Authorized>

            <MudNavLink Href="/employee/home" Match="NavLinkMatch.All">
                <MudIcon Icon="@Icons.Material.Filled.Home" />
                <span class="nav-label">@Texts["Nav.Home"]</span>
            </MudNavLink>

            <MudNavLink Href="/employee/dashboard">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" />
                <span class="nav-label">@Texts["Nav.Dashboard"]</span>
            </MudNavLink>

            <MudNavLink Href="/employee/select-service">
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" />
                <span class="nav-label">@Texts["Nav.SwitchService"]</span>
            </MudNavLink>

        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@AuthorizationPolicies.DienstplanVerwalten">
        <Authorized>

            <MudDivider Class="my-2" />

            <MudNavLink Href="/admin/employees">
                <MudIcon Icon="@Icons.Material.Filled.People" />
                <span class="nav-label">@Texts["Nav.Employees"]</span>
            </MudNavLink>

            <MudNavLink Href="/admin/assignments">
                <MudIcon Icon="@Icons.Material.Filled.Link" />
                <span class="nav-label">@Texts["Nav.Assignments"]</span>
            </MudNavLink>

            <MudNavLink Href="/admin/working-schedule">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                <span class="nav-label">@Texts["Nav.WorkingHours"]</span>
            </MudNavLink>

        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@AuthorizationPolicies.AdministrationVerwalten">
        <Authorized>

            <MudNavLink Href="/admin/services">
                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" />
                <span class="nav-label">@Texts["Nav.Services"]</span>
            </MudNavLink>

        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@AuthorizationPolicies.MitarbeiterZugriff">
        <Authorized>

            <MudDivider Class="my-2" />

            @* Vollständiger Seitenaufruf: die Abmeldung löscht das Cookie im
               HTTP-Kontext und ist daher eine Razor Page, kein Blazor-Aufruf. *@
            <MudNavLink Href="/employee/logout" ForceLoad="true">
                <MudIcon Icon="@Icons.Material.Filled.Logout" />
                <span class="nav-label">@Texts["Nav.Logout"]</span>
            </MudNavLink>

        </Authorized>
    </AuthorizeView>

</MudNavMenu>

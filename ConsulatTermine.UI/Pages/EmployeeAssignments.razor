@page "/admin/assignments"
@attribute [Authorize(Policy = AuthorizationPolicies.DienstplanVerwalten)]

@using ConsulatTermine.Domain.Enums
@using ConsulatTermine.Application.Exceptions
@using ConsulatTermine.Application.Interfaces
@using ConsulatTermine.Domain.Entities

@inject IEmployeeAuthorization Authorization
@inject IEmployeeAssignmentService AssignmentService
@inject IEmployeeService EmployeeService
@inject IServiceService ServiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<EmployeeAssignments> Logger
@inject IStringLocalizer<AdministrationTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@Texts["Assignments.Title"]</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Spacing="3">

        <MudText Typo="Typo.h5" HtmlTag="h1">@Texts["Assignments.Title"]</MudText>

        <MudTable Items="_assignments" Hover Dense aria-label="@Texts["Assignments.TableAria"]">
            <HeaderContent>
                <MudTh>@Texts["Assignments.Column.Employee"]</MudTh>
                <MudTh>@Texts["Assignments.Column.Service"]</MudTh>
                <MudTh>@Texts["Assignments.Column.Actions"]</MudTh>
            </HeaderContent>

            <RowTemplate>
                @{
                    var employeeName = NameOf(context.Employee);
                    var serviceName = NameOf(context.Service);
                }

                <MudTd DataLabel="@Texts["Assignments.Column.Employee"]">@employeeName</MudTd>

                <MudTd DataLabel="@Texts["Assignments.Column.Service"]">@serviceName</MudTd>

                <MudTd DataLabel="@Texts["Assignments.Column.Actions"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   title="@Texts["Assignments.DeleteAria", employeeName, serviceName]"
                                   aria-label="@Texts["Assignments.DeleteAria", employeeName, serviceName]"
                                   OnClick="@(() => ConfirmDeleteAssignmentAsync(context))" />
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>@Texts["Assignments.Empty"]</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" HtmlTag="h2">@Texts["Assignments.New"]</MudText>

            <MudStack Spacing="2">

                <MudSelect T="int?"
                           Label="@Texts["Assignments.Column.Employee"]"
                           Placeholder="@Texts["Assignments.SelectEmployee"]"
                           @bind-Value="_selectedEmployee">
                    @foreach (var employee in _employees)
                    {
                        <MudSelectItem T="int?" Value="@employee.Id">
                            @($"{employee.FirstName} {employee.LastName}")
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?"
                           Label="@Texts["Assignments.Column.Service"]"
                           Placeholder="@Texts["Assignments.SelectService"]"
                           @bind-Value="_selectedService">
                    @foreach (var service in _services)
                    {
                        <MudSelectItem T="int?" Value="@service.Id">
                            @service.NameFor(CultureInfo.CurrentUICulture.Name)
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_saving"
                           OnClick="AddAssignmentAsync">
                    @Texts["Assignments.Add"]
                </MudButton>

            </MudStack>
        </MudPaper>

    </MudStack>
</MudPaper>

@code {

    private List<EmployeeServiceAssignment> _assignments = [];
    private List<Employee> _employees = [];
    private List<Service> _services = [];

    private int? _selectedEmployee;
    private int? _selectedService;
    private bool _saving;

    private int _currentEmployeeId;
    private bool _isAdmin;

    // Der Zugang zu dieser Seite wird über [Authorize] geprüft; die
    // Anwendungsfälle prüfen die Berechtigung serverseitig zusätzlich.
    protected override async Task OnInitializedAsync()
    {
        var current = await Authorization.RequireEmployeeAsync();
        _currentEmployeeId = current.EmployeeId;
        _isAdmin = current.Role == EmployeeRole.Admin;

        await LoadDataAsync();
    }

    private string NameOf(Employee? employee) =>
        employee is null
            ? Texts["Assignments.Unknown"]
            : $"{employee.FirstName} {employee.LastName}";

    private string NameOf(Service? service) =>
        service is null
            ? Texts["Assignments.Unknown"]
            : service.NameFor(CultureInfo.CurrentUICulture.Name);

    private async Task LoadDataAsync()
    {
        _services = _isAdmin
            ? await ServiceService.GetAllServicesAsync()
            : await ServiceService.GetServicesForEmployeeAsync(_currentEmployeeId);

        var allAssignments = await AssignmentService.GetAllAssignmentsAsync();

        if (_isAdmin)
        {
            _assignments = allAssignments;
        }
        else
        {
            var allowedServiceIds = _services.Select(service => service.Id).ToHashSet();
            _assignments = allAssignments
                .Where(assignment => allowedServiceIds.Contains(assignment.ServiceId))
                .ToList();
        }

        var allEmployees = await EmployeeService.GetAllEmployeesAsync();

        if (_isAdmin)
        {
            _employees = allEmployees;
        }
        else
        {
            var allowedServiceIds = _services.Select(service => service.Id).ToHashSet();

            _employees = allEmployees
                .Where(employee =>
                    employee.AssignedServices.Count == 0 ||
                    employee.AssignedServices.Any(assignment => allowedServiceIds.Contains(assignment.ServiceId)))
                .ToList();
        }
    }

    private async Task AddAssignmentAsync()
    {
        if (!_selectedEmployee.HasValue || !_selectedService.HasValue)
        {
            Snackbar.Add(Texts["Assignments.Incomplete"], Severity.Warning);
            return;
        }

        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var added = await AssignmentService.AddAssignmentAsync(
                _selectedEmployee.Value,
                _selectedService.Value);

            if (added)
            {
                Snackbar.Add(Texts["Assignments.Added"], Severity.Success);
                _selectedEmployee = null;
                _selectedService = null;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(Texts["Assignments.Exists"], Severity.Warning);
            }
        }
        catch (BusinessRuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Texts["Assignments.AddFailed"], Severity.Error);
            Logger.LogError(ex, "Die Zuweisung konnte nicht angelegt werden.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAssignmentAsync(EmployeeServiceAssignment assignment)
    {
        var employeeName = NameOf(assignment.Employee);
        var serviceName = NameOf(assignment.Service);

        var parameters = new DialogParameters
        {
            ["Title"] = Texts["Assignments.DeleteTitle"].Value,
            ["Message"] = Texts["Assignments.DeleteMessage", employeeName, serviceName].Value
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            Texts["Assignments.DeleteTitle"],
            parameters);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await DeleteAssignmentAsync(assignment);
        }
    }

    private async Task DeleteAssignmentAsync(EmployeeServiceAssignment assignment)
    {
        try
        {
            var removed = await AssignmentService.RemoveAssignmentAsync(
                assignment.EmployeeId,
                assignment.ServiceId);

            if (removed)
            {
                Snackbar.Add(Texts["Assignments.Deleted"], Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add(Texts["Assignments.NotFound"], Severity.Warning);
            }
        }
        catch (BusinessRuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Texts["Assignments.DeleteFailed"], Severity.Error);
            Logger.LogError(ex, "Die Zuweisung konnte nicht geloescht werden.");
        }
    }
}

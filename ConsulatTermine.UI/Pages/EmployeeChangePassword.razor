@page "/employee/change-password"
@attribute [Authorize(Policy = AuthorizationPolicies.MitarbeiterZugriff)]

@inject NavigationManager Navigation
@inject ConsulatTermine.Application.Interfaces.IEmployeeAuthService AuthService
@inject IEmployeeAuthorization Authorization
@inject IStringLocalizer<EmployeeTexts> Texts

<PageTitle>@Texts["ChangePassword.Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard>
        <MudCardContent>

            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" HtmlTag="h1">
                @Texts["ChangePassword.Title"]
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">

                <MudTextField T="string"
                              Label="@Texts["Password.New"]"
                              @bind-Value="_newPassword"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              AdornmentAriaLabel="@_passwordToggleLabel"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Required="true"
                              RequiredError="@Texts["Password.RequiredNew"]"
                              Variant="Variant.Outlined"
                              autocomplete="new-password"
                              dir="ltr" />

                <MudTextField T="string"
                              Label="@Texts["Password.Confirm"]"
                              @bind-Value="_confirmPassword"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              AdornmentAriaLabel="@_passwordToggleLabel"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Required="true"
                              RequiredError="@Texts["Password.RequiredConfirm"]"
                              Variant="Variant.Outlined"
                              Class="mt-4"
                              autocomplete="new-password"
                              dir="ltr" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2" role="alert">
                        @_errorMessage
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!_isValid || _saving)"
                           OnClick="PerformChangePassword"
                           Class="mt-6"
                           FullWidth="true">
                    @Texts["Password.Save"]
                </MudButton>

            </MudForm>

        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // Die Id stammt aus der serverseitigen Anmeldung, nicht aus der Adresszeile:
    // als Routenparameter hätte jeder das Passwort beliebiger Mitarbeiter ändern können.
    private int _employeeId;

    private MudForm? _form;
    private bool _isValid;
    private bool _saving;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;

    private bool _showPassword;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private string _passwordToggleLabel =>
        _showPassword ? Texts["Password.Hide"] : Texts["Password.Show"];

    protected override async Task OnInitializedAsync()
    {
        var current = await Authorization.RequireEmployeeAsync();
        _employeeId = current.EmployeeId;
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;

        _passwordInputType = _showPassword ? InputType.Text : InputType.Password;
        _passwordIcon = _showPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task PerformChangePassword()
    {
        if (_form is null || _saving)
        {
            return;
        }

        await _form.Validate();

        if (!_isValid)
        {
            return;
        }

        _errorMessage = string.Empty;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = Texts["Password.Mismatch"];
            return;
        }

        _saving = true;

        try
        {
            var success = await AuthService.ChangePasswordAsync(_employeeId, _newPassword);

            if (!success)
            {
                _errorMessage = Texts["Password.SaveFailed"];
                return;
            }

            // Vollständiger Aufruf: das Cookie muss ohne den Claim MustChangePassword
            // neu ausgestellt werden.
            Navigation.NavigateTo("/employee/login", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }
}

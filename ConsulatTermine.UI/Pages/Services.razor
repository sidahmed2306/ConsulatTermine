@page "/services"
@attribute [AllowAnonymous]

@using ConsulatTermine.Application.DTOs
@using MudBlazor
@using ConsulatTermine.Application.Interfaces
@using ConsulatTermine.Application.Services
@using ConsulatTermine.Domain.Entities
@using Blazored.SessionStorage

@inject IServiceService ServiceService
@inject ISessionStorageService Session
@inject NavigationManager Navigation



<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto mt-8">

    <!-- STEPPER -->
    <BookingStepper ActiveStep="0" />

    <MudCard Class="pa-6" Style="border-radius:12px">

        <!-- HEADER -->
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Success">
            Termin buchen
        </MudText>

        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-6">
            Für wie viele Personen möchten Sie einen Termin buchen?
        </MudText>

        <!-- PERSON COUNTER -->
        <MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Success" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@(_personCount <= 1)"
                       OnClick="DecrementPerson"
                       aria-label="Eine Person weniger">
                <MudIcon Icon="@Icons.Material.Filled.Remove" />
            </MudButton>

            <MudText Typo="Typo.h6" aria-live="polite">@_personCount</MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@(_personCount >= ServiceSelectionCalculator.MaxPersons)"
                       OnClick="IncrementPerson"
                       aria-label="Eine Person mehr">
                <MudIcon Icon="@Icons.Material.Filled.Add" />
            </MudButton>
        </MudStack>

        <MudDivider Class="mb-4" />

        <!-- SERVICES -->
        <MudText Typo="Typo.subtitle1" Class="mb-1">
            Für welche Services möchten Sie Termine buchen?
        </MudText>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Zählen Sie je Service, wie viele Personen ihn benötigen.
            Jede Person braucht mindestens einen Termin, höchstens
            @ServiceSelectionCalculator.MaxServicesPerPerson Termine.
        </MudText>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate aria-label="Services werden geladen" />
        }
        else if (_services.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                Zurzeit stehen keine Services zur Buchung bereit. Bitte versuchen Sie es später erneut.
            </MudAlert>
        }
        else
        {
            @foreach (var service in _services)
            {
                <MudCard Class="mb-3" Style="background:#f9f9f9">
                    <MudCardContent>

                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

                            <!-- INFO -->
                            <MudStack Class="flex-grow-1">
                                <MudText Typo="Typo.h6">@service.Name</MudText>

                                @if (!string.IsNullOrWhiteSpace(service.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @service.Description
                                    </MudText>
                                }
                            </MudStack>

                            <!-- COUNTER -->
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                               Color="Color.Error"
                                               Disabled="@(!ServiceSelectionCalculator.CanRemoveService(_serviceAssignments, service.Id))"
                                               OnClick="@(() => DecrementService(service.Id))"
                                               title="@($"{service.Name}: eine Person weniger")"
                                               aria-label="@($"{service.Name}: eine Person weniger")" />

                                <MudText Typo="Typo.subtitle1" aria-live="polite">
                                    @GetAssignedCount(service.Id)
                                </MudText>

                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Color="Color.Success"
                                               Disabled="@(!ServiceSelectionCalculator.CanAddService(_serviceAssignments, service.Id, _personCount))"
                                               OnClick="@(() => IncrementService(service.Id))"
                                               title="@($"{service.Name}: eine Person mehr")"
                                               aria-label="@($"{service.Name}: eine Person mehr")" />
                            </MudStack>

                        </MudStack>

                    </MudCardContent>
                </MudCard>
            }
        }

        <MudDivider Class="mt-4" />

        <!-- STATUS -->
        @if (!_loading && _services.Count > 0)
        {
            <MudAlert Severity="@(CanConfirm ? Severity.Success : Severity.Info)"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="mt-4"
                      aria-live="polite">
                @SelectionStatusText
            </MudAlert>
        }

        <!-- FOOTER -->
        <MudStack Row Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Success"
                       OnClick="ResetAll">
                Zurücksetzen
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@(!CanConfirm)"
                       OnClick="ConfirmSelection">
                Bestätigen
            </MudButton>

        </MudStack>

    </MudCard>
</MudContainer>

@code {

    /* ---------- STATE ---------- */
    private int _personCount = 1;
    private bool _loading = true;
    private List<Service> _services = new();

    // ServiceId -> Anzahl der Personen, die diesen Service benoetigen
    private Dictionary<int, int> _serviceAssignments = new();

    /* ---------- CALCULATED ---------- */
    private bool CanConfirm =>
        ServiceSelectionCalculator.IsSelectionComplete(_serviceAssignments, _personCount);

    /// <summary>
    /// Erklaert, warum "Bestaetigen" noch gesperrt ist. Ohne diesen Hinweis ist die Regel
    /// "jede Person braucht mindestens einen Termin" auf der Seite nicht erkennbar.
    /// </summary>
    private string SelectionStatusText
    {
        get
        {
            var total = ServiceSelectionCalculator.TotalAssigned(_serviceAssignments);
            var missing = ServiceSelectionCalculator.MissingAssignments(_serviceAssignments, _personCount);

            if (missing > 0)
            {
                return $"{total} von mindestens {_personCount} Terminen zugeordnet. "
                     + $"Bitte ordnen Sie noch {AppointmentLabel(missing)} zu.";
            }

            return $"{AppointmentLabel(total)} für {PersonLabel(_personCount)} zugeordnet. "
                 + "Sie können fortfahren.";
        }
    }

    /* ---------- INIT ---------- */
    protected override async Task OnInitializedAsync()
    {
        _services = await ServiceService.GetAllServicesAsync();
        _loading = false;
    }

    /* ---------- HELPERS ---------- */
    private int GetAssignedCount(int serviceId)
        => ServiceSelectionCalculator.AssignedCount(_serviceAssignments, serviceId);

    private static string PersonLabel(int count)
        => count == 1 ? "1 Person" : $"{count} Personen";

    private static string AppointmentLabel(int count)
        => count == 1 ? "1 Termin" : $"{count} Termine";

    /* ---------- PERSON ---------- */
    private void IncrementPerson()
    {
        if (_personCount >= ServiceSelectionCalculator.MaxPersons)
            return;

        _personCount++;
        _serviceAssignments = ServiceSelectionCalculator.Normalize(_serviceAssignments, _personCount);
    }

    private void DecrementPerson()
    {
        if (_personCount <= 1)
            return;

        _personCount--;
        _serviceAssignments = ServiceSelectionCalculator.Normalize(_serviceAssignments, _personCount);
    }

    /* ---------- SERVICE ---------- */
    private void IncrementService(int serviceId)
    {
        if (!ServiceSelectionCalculator.CanAddService(_serviceAssignments, serviceId, _personCount))
            return;

        _serviceAssignments[serviceId] = GetAssignedCount(serviceId) + 1;
    }

    private void DecrementService(int serviceId)
    {
        if (!ServiceSelectionCalculator.CanRemoveService(_serviceAssignments, serviceId))
            return;

        var remaining = GetAssignedCount(serviceId) - 1;

        if (remaining <= 0)
        {
            _serviceAssignments.Remove(serviceId);
            return;
        }

        _serviceAssignments[serviceId] = remaining;
    }

    /* ---------- NAV ---------- */
    private async Task ConfirmSelection()
    {
        if (!CanConfirm)
            return;

        await Session.SetItemAsync(SessionKeys.PersonCount, _personCount);
        await Session.SetItemAsync(SessionKeys.ServiceAssignments, _serviceAssignments);

        Navigation.NavigateTo("/appointment");
    }

    private void ResetAll()
    {
        _personCount = 1;
        _serviceAssignments = new Dictionary<int, int>();
    }
}

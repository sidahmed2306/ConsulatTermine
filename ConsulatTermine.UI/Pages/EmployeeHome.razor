@page "/employee/home"
@page "/employee/"
@attribute [Authorize(Policy = AuthorizationPolicies.MitarbeiterZugriff)]

@using ConsulatTermine.Application.Interfaces

@inject NavigationManager Navigation
@inject IEmployeeAuthorization Authorization
@inject IEmployeeService EmployeeService
@inject ILogger<EmployeeHome> Logger
@inject IStringLocalizer<EmployeeTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@CommonTexts["Nav.Home"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False"
              Class="d-flex justify-center align-center"
              Style="min-height: calc(100vh - 120px);">

    <MudPaper Elevation="1" Class="pa-8 text-center" Style="min-width:420px;">

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large"
                                 Class="my-6"
                                 aria-label="@Texts["Home.Loading"]" />
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                @Texts["Home.Loading"]
            </MudText>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" role="alert">
                @_error
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.h3" Color="Color.Primary" GutterBottom="true" HtmlTag="h1">
                @Texts["Home.Welcome"]
            </MudText>

            <MudText Typo="Typo.h4" Class="mb-4">
                @_firstName @_lastName
            </MudText>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                @Texts["Home.Greeting", _firstName]
            </MudText>

            <MudText Typo="Typo.body1" Class="mt-3">
                @Texts["Home.NextStep"]
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-4"
                       OnClick="@(() => Navigation.NavigateTo("/employee/select-service"))">
                @Texts["Home.StartWork"]
            </MudButton>
        }

    </MudPaper>

</MudContainer>

@code {

    private bool _loading = true;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Die Kennung stammt aus der serverseitigen Anmeldung. Der Anwendungsfall
            // prueft zusaetzlich, dass ein Mitarbeiter nur den eigenen Datensatz liest.
            var current = await Authorization.RequireEmployeeAsync();

            var employee = await EmployeeService.GetEmployeeByIdAsync(current.EmployeeId);
            if (employee is null)
            {
                _error = Texts["Home.NotFound"];
                return;
            }

            _firstName = employee.FirstName;
            _lastName = employee.LastName;
        }
        catch (Exception ex)
        {
            // Die Anzeige bleibt allgemein, die Einzelheiten gehoeren ins Log.
            _error = Texts["Home.LoadFailed"];
            Logger.LogError(ex, "Die Mitarbeiterdaten der Startseite konnten nicht geladen werden.");
        }
        finally
        {
            _loading = false;
        }
    }
}

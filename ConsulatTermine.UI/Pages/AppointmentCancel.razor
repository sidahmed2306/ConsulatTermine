@page "/appointment-cancel"
@attribute [AllowAnonymous]

@using ConsulatTermine.Domain.Entities
@using ConsulatTermine.Domain.Enums
@using Microsoft.AspNetCore.WebUtilities

@inject ConsulatTermine.Application.Interfaces.IAppointmentService AppointmentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<AppointmentCancel> Logger
@inject IStringLocalizer<BookingTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@Texts["Cancel.Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto mt-8">

    <MudCard Class="pa-6" Style="border-radius:12px">

        <MudText Typo="Typo.h5" Class="mb-3" HtmlTag="h1">
            @Texts["Cancel.Title"]
        </MudText>

        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" aria-label="@CommonTexts["State.Loading"]" />
        }
        else if (ErrorMessage != null)
        {
            <MudAlert Severity="Severity.Error" role="alert">
                @ErrorMessage
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                @Texts["Cancel.Hint"]
            </MudAlert>

            <MudTable Items="Appointments" Dense="true" aria-label="@Texts["Cancel.TableAria"]">
                <HeaderContent>
                    <MudTh>@Texts["Cancel.Column.Service"]</MudTh>
                    <MudTh>@Texts["Cancel.Column.Date"]</MudTh>
                    <MudTh>@Texts["Cancel.Column.Name"]</MudTh>
                    <MudTh>@Texts["Cancel.Column.Status"]</MudTh>
                    <MudTh>@Texts["Cancel.Column.Action"]</MudTh>
                </HeaderContent>

                <RowTemplate>
                    @{
                        var serviceName = context.Service?.NameFor(CultureInfo.CurrentUICulture.Name) ?? string.Empty;
                        var appointmentMoment = context.Date.ToString("g", CultureInfo.CurrentCulture);
                    }

                    <MudTd DataLabel="@Texts["Cancel.Column.Service"]">@serviceName</MudTd>

                    <MudTd DataLabel="@Texts["Cancel.Column.Date"]">@appointmentMoment</MudTd>

                    <MudTd DataLabel="@Texts["Cancel.Column.Name"]">@context.FullName</MudTd>

                    <MudTd DataLabel="@Texts["Cancel.Column.Status"]">
                        @context.Status.ToDisplayText(CommonTexts)
                    </MudTd>

                    <MudTd DataLabel="@Texts["Cancel.Column.Action"]">
                        @if (context.Status == AppointmentStatus.Booked)
                        {
                            <MudButton Color="Color.Error"
                                       Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Disabled="@IsCancelling"
                                       aria-label="@Texts["Cancel.ButtonAria", serviceName, appointmentMoment]"
                                       OnClick="@(() => CancelSingleAsync(context.Id))">
                                @Texts["Cancel.Button"]
                            </MudButton>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">@Texts["Cancel.NotCancellable"]</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider Class="my-4" />

            <MudButton Variant="Variant.Outlined"
                       OnClick="@(() => Navigation.NavigateTo("/"))">
                @CommonTexts["Action.Cancel"]
            </MudButton>
        }

    </MudCard>
</MudContainer>

@code {

    private bool IsLoading = true;
    private bool IsCancelling = false;
    private string? ErrorMessage;

    private string? BookingReference;
    private string? CancelToken;

    private List<Appointment> Appointments = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);

            BookingReference = query.TryGetValue("ref", out var r) ? r.ToString() : null;
            CancelToken = query.TryGetValue("token", out var t) ? t.ToString() : null;

            if (string.IsNullOrWhiteSpace(BookingReference) ||
                string.IsNullOrWhiteSpace(CancelToken))
            {
                ErrorMessage = Texts["Cancel.Error.InvalidLink"];
                return;
            }

            // 1️⃣ Termine laden
            Appointments = await AppointmentService
                .GetByBookingReferenceAsync(BookingReference);

            if (!Appointments.Any())
            {
                ErrorMessage = Texts["Cancel.Error.NotFound"];
                return;
            }

            // 2️⃣ Token & Ablauf prüfen (EINMAL)
            var first = Appointments.First();

            if (first.CancelToken != CancelToken)
            {
                ErrorMessage = Texts["Cancel.Error.InvalidLink"];
                return;
            }

            if (!first.CancelTokenExpiresAt.HasValue ||
                first.CancelTokenExpiresAt.Value < DateTime.UtcNow)
            {
                ErrorMessage = Texts["Cancel.Error.Expired"];
                return;
            }
        }
        catch (Exception ex)
        {
            // Die Anzeige bleibt allgemein: der Details gehören in das geschützte Log,
            // nicht auf eine öffentlich erreichbare Seite.
            ErrorMessage = Texts["Cancel.Error.LoadFailed"];
            Logger.LogError(ex, "Termin zur Buchung {BookingReference} konnte nicht geladen werden.", BookingReference);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CancelSingleAsync(int appointmentId)
    {
        IsCancelling = true;

        try
        {
            await AppointmentService.CancelAsync(appointmentId);

            Snackbar.Add(Texts["Cancel.Success"], Severity.Success);

            // 🔄 Liste neu laden
            Appointments = await AppointmentService
    .GetByBookingReferenceAsync(BookingReference!);

// ✅ WENN alle Termine storniert sind → weiterleiten
if (Appointments.All(a => a.Status == AppointmentStatus.Cancelled))
{
    Navigation.NavigateTo(
        $"/appointment-cancel-success?ref={Uri.EscapeDataString(BookingReference!)}");
}
        }
        catch (Exception ex)
        {
            Snackbar.Add(Texts["Cancel.Failed"], Severity.Error);
            Logger.LogError(ex, "Termin {AppointmentId} konnte nicht abgesagt werden.", appointmentId);
        }
        finally
        {
            IsCancelling = false;
        }
    }
}

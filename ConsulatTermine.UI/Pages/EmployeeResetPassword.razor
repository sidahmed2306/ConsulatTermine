@page "/employee/reset-password"
@attribute [AllowAnonymous]

@using ConsulatTermine.Application.Interfaces

@inject NavigationManager Navigation
@inject IEmployeeAuthService AuthService
@inject IStringLocalizer<EmployeeTexts> Texts

<PageTitle>@Texts["ResetPassword.Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False"
              Class="d-flex justify-center align-center"
              Style="min-height: calc(50vh - 120px);">

    <MudCard Class="login-card" Style="width:420px; margin-top:60px;">
        <MudCardContent>

            <MudText Typo="Typo.h4"
                     Align="Align.Center"
                     Class="mb-6"
                     Color="Color.Primary"
                     HtmlTag="h1">
                @Texts["ResetPassword.Title"]
            </MudText>

            @if (_invalidToken)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">
                    @Texts["ResetPassword.Invalid"]
                </MudAlert>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/employee/forgot-password"
                           FullWidth="true">
                    @Texts["ResetPassword.RequestNew"]
                </MudButton>
            }
            else
            {
                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudTextField T="string"
                                  Label="@Texts["Password.New"]"
                                  @bind-Value="_newPassword"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  AdornmentAriaLabel="@_passwordToggleLabel"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Required="true"
                                  RequiredError="@Texts["Password.RequiredNew"]"
                                  Variant="Variant.Outlined"
                                  autocomplete="new-password"
                                  dir="ltr" />

                    <MudTextField T="string"
                                  Label="@Texts["Password.Confirm"]"
                                  @bind-Value="_confirmPassword"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  AdornmentAriaLabel="@_passwordToggleLabel"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Required="true"
                                  RequiredError="@Texts["Password.RequiredConfirm"]"
                                  Variant="Variant.Outlined"
                                  Class="mt-4"
                                  autocomplete="new-password"
                                  dir="ltr" />

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" role="alert">
                            @_errorMessage
                        </MudAlert>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(_form is null || _saving)"
                               OnClick="PerformReset"
                               Class="mt-6"
                               FullWidth="true">
                        @Texts["Password.Save"]
                    </MudButton>
                </MudForm>

                <MudDivider Class="my-4" />

                <MudLink Href="/employee/login" Class="d-flex justify-center">
                    @Texts["ForgotPassword.BackToLogin"]
                </MudLink>
            }

        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private bool _saving;

    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;

    private bool _invalidToken;
    private bool _showPassword;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private string _passwordToggleLabel =>
        _showPassword ? Texts["Password.Hide"] : Texts["Password.Show"];

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _invalidToken = true;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;

        _passwordInputType = _showPassword ? InputType.Text : InputType.Password;
        _passwordIcon = _showPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task PerformReset()
    {
        if (_form is null || _saving || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        await _form.Validate();

        if (!_isValid)
        {
            return;
        }

        _errorMessage = string.Empty;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = Texts["Password.Mismatch"];
            return;
        }

        _saving = true;

        try
        {
            var success = await AuthService.ResetPasswordWithTokenAsync(Token, _newPassword);

            if (!success)
            {
                _invalidToken = true;
                return;
            }

            Navigation.NavigateTo("/employee/login");
        }
        finally
        {
            _saving = false;
        }
    }
}

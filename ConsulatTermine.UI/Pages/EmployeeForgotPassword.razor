@page "/employee/forgot-password"
@attribute [AllowAnonymous]

@using ConsulatTermine.Application.Interfaces

@inject NavigationManager Navigation
@inject IEmployeeAuthService AuthService
@inject IStringLocalizer<EmployeeTexts> Texts
@inject IStringLocalizer<ValidationTexts> Validation

<PageTitle>@Texts["ForgotPassword.Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False"
              Class="d-flex justify-center align-center"
              Style="min-height: calc(50vh - 120px);">

    <MudCard Class="login-card" Style="width:420px; margin-top:60px;">
        <MudCardContent>

            <MudText Typo="Typo.h4"
                     Align="Align.Center"
                     Class="mb-6"
                     Color="Color.Primary"
                     HtmlTag="h1">
                @Texts["ForgotPassword.Title"]
            </MudText>

            <MudText Typo="Typo.body2" Class="mb-4" Align="Align.Center">
                @Texts["ForgotPassword.Intro"]
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudTextField T="string"
                              Label="@Texts["ForgotPassword.Email"]"
                              @bind-Value="_email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="@Validation["EmailRequired"]"
                              Variant="Variant.Outlined"
                              autocomplete="email"
                              dir="ltr" />

                @if (_requestSent)
                {
                    @* Die Rueckmeldung ist bewusst gleich, ob es das Konto gibt oder
                       nicht: sonst liesse sich ueber diese Maske pruefen, welche
                       Adressen hinterlegt sind. Siehe harness/security.md Abschnitt 4. *@
                    <MudAlert Severity="Severity.Success" Class="mt-2" role="status">
                        @Texts["ForgotPassword.Sent"]
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(_form is null || _sending)"
                           OnClick="RequestReset"
                           Class="mt-6"
                           FullWidth="true">
                    @Texts["ForgotPassword.Submit"]
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudLink Href="/employee/login" Class="d-flex justify-center">
                @Texts["ForgotPassword.BackToLogin"]
            </MudLink>

        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm? _form;
    private bool _isValid;
    private bool _sending;
    private bool _requestSent;

    private string _email = string.Empty;

    private async Task RequestReset()
    {
        if (_form is null || _sending)
        {
            return;
        }

        await _form.Validate();

        if (!_isValid)
        {
            return;
        }

        _sending = true;

        try
        {
            await AuthService.RequestPasswordResetAsync(_email.Trim());
            _requestSent = true;
        }
        finally
        {
            _sending = false;
        }
    }
}

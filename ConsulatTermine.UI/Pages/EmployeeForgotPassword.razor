@page "/employee/forgot-password"

@using MudBlazor
@using ConsulatTermine.Application.Interfaces

@inject NavigationManager Navigation
@inject IEmployeeAuthService AuthService

<MudContainer MaxWidth="MaxWidth.False"
              Class="d-flex justify-center align-center"
              Style="min-height: calc(50vh - 120px);">

    <MudCard Class="login-card" Style="width:420px; margin-top:60px;">
        <MudCardContent>

            <MudText Typo="Typo.h4"
                     Align="Align.Center"
                     Class="mb-6"
                     Color="Color.Primary">
                Passwort vergessen
            </MudText>

            <MudText Typo="Typo.body2" Class="mb-4" Align="Align.Center">
                Geben Sie Ihre dienstliche E-Mail-Adresse ein. Wir senden Ihnen einen Link zum Zurücksetzen Ihres Passworts.
            </MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudTextField T="string"
                             Label="E-Mail-Adresse"
                             @bind-Value="_email"
                             InputType="InputType.Email"
                             Required="true"
                             RequiredError="E-Mail ist erforderlich"
                             Variant="Variant.Outlined" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudText Color="Color.Error" Class="mt-2">
                        @_errorMessage
                    </MudText>
                }

                @if (_successMessage)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2">
                        Falls ein Konto mit dieser E-Mail existiert, wurde ein Link zum Zurücksetzen des Passworts gesendet.
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_form is null"
                           OnClick="RequestReset"
                           Class="mt-6"
                           FullWidth="true">
                    Link senden
                </MudButton>
            </MudForm>

            <MudDivider Class="my-4" />

            <MudLink Href="/employee/login" Class="d-flex justify-center">
                Zurück zum Login
            </MudLink>

        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private MudForm? _form;
    private bool _isValid;

    private string _email = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _successMessage;

    private async Task RequestReset()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_isValid)
            return;

        _errorMessage = string.Empty;
        _successMessage = false;

        await AuthService.RequestPasswordResetAsync(_email.Trim());

        _successMessage = true;
    }
}

@page "/tv/waiting-room"
@attribute [AllowAnonymous]
@implements IDisposable

@using ConsulatTermine.Domain.Entities
@using ConsulatTermine.Domain.Enums
@using ConsulatTermine.Application.Interfaces

@inject IAppointmentService AppointmentService
@inject IWaitingRoomNotifier WaitingRoomNotifier
@inject IJSRuntime JS
@inject IStringLocalizer<WaitingRoomTexts> Texts

<PageTitle>@Texts["Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False"
              Class="pa-6 waiting-room-root">

    <!-- HEADER -->
    <MudPaper Class="pa-4 mb-6">
        <MudText Typo="Typo.h4" HtmlTag="h1">
            @Texts["Title"]
        </MudText>

        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" aria-live="polite">
            @Texts["LastUpdated", _lastUpdated.ToString("HH:mm:ss", CultureInfo.CurrentCulture)]
        </MudText>

        @if (!_soundEnabled)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Class="mt-3"
                       StartIcon="@Icons.Material.Filled.VolumeUp"
                       OnClick="EnableSoundAsync">
                @Texts["EnableSound"]
            </MudButton>

            <MudText Typo="Typo.caption" Class="d-block mt-1">
                @Texts["SoundHint"]
            </MudText>
        }
    </MudPaper>

    <!-- CARDS -->
    @if (_activeCalls.Count == 0)
    {
        @* Ohne eigenen Leerzustand zeigte die Anzeige eine leere Flaeche, die von
           einer Stoerung nicht zu unterscheiden waere. *@
        <MudPaper Elevation="0" Class="pa-8 text-center">
            <MudText Typo="Typo.h5" Color="Color.Secondary">
                @Texts["Empty"]
            </MudText>
        </MudPaper>
    }

    <MudGrid Spacing="4">
        @foreach (var call in _activeCalls)
        {
            var serviceName = call.Service?.NameFor(CultureInfo.CurrentUICulture.Name) ?? string.Empty;

            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="6"
                          Class="pa-5  tv-card"
                          data-appointment-id="@call.Id"
                          aria-label="@Texts["CardAria", call.FullName, serviceName]">

                    <!-- HEADER -->
                    <div class="tv-card-header">
                        <MudText Typo="Typo.h4" Class="tv-name">
                            @call.FullName
                        </MudText>

                        <MudChip T="String" Color="Color.Primary"
                                 Variant="Variant.Filled"
                                 Class="tv-service-chip">
                            @serviceName
                        </MudChip>
                    </div>

                    <MudDivider Class="my-4" />

                    <!-- INFO GRID -->
                    @if (WaitingRoomNotifier.TryGetWorkplace(
                        call.Id,
                        out var office,
                        out var room))
                    {
                        <MudGrid Justify="Justify.SpaceAround" Class="align-center">

                            <MudItem xs="4" Class="tv-info-item">
                                <div class="tv-ball">@office</div>
                                <div class="tv-label">@Texts["Office"]</div>
                            </MudItem>

                            <MudItem xs="4" Class="tv-info-item">
                                <div class="tv-ball">@room</div>
                                <div class="tv-label">@Texts["Room"]</div>
                            </MudItem>

                            <MudItem xs="4" Class="tv-info-item">
                                <div class="tv-ball">
                                    @call.Service?.Floor
                                </div>
                                <div class="tv-label">@Texts["Floor"]</div>
                            </MudItem>

                        </MudGrid>
                    }

                    <MudDivider Class="my-4" />

                    <!-- STATUS -->
                    <div class="tv-status">
                        <MudChip T="String" Color="Color.Warning"
                                 Variant="Variant.Filled"
                                 Size="Size.Large">
                            @Texts["GoToOffice"]
                        </MudChip>
                    </div>

                </MudPaper>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

@code {
    private List<Appointment> _activeCalls = new();
    private DateTime _lastUpdated;

    private bool _soundEnabled;
    private bool _pendingSound;
    private int? _animateAppointmentId;

    protected override async Task OnInitializedAsync()
    {
        WaitingRoomNotifier.OnChanged += HandleChanged;
        await LoadAsync();
    }

    private void HandleChanged(
        WaitingRoomChangeReason reason,
        int? appointmentId)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();

            if (_soundEnabled &&
                (reason == WaitingRoomChangeReason.Call ||
                 reason == WaitingRoomChangeReason.Recall))
            {
                _pendingSound = true;
                _animateAppointmentId = appointmentId;
            }

            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingSound)
        {
            _pendingSound = false;
            await JS.InvokeVoidAsync(
                "onWaitingRoomUpdated",
                _animateAppointmentId);
        }
    }

    private async Task EnableSoundAsync()
    {
        _soundEnabled =
            await JS.InvokeAsync<bool>("SoundService.unlock");
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _activeCalls = (await AppointmentService
                .GetActiveWaitingRoomAppointmentsAsync())
            .Where(a => a.Status == AppointmentStatus.InProgress)
            .OrderBy(a => a.Date)
            .ToList();

        _lastUpdated = DateTime.Now;
    }

    public void Dispose()
    {
        WaitingRoomNotifier.OnChanged -= HandleChanged;
    }
}

@page "/employee/login"
@model ConsulatTermine.UI.Pages.Account.LoginModel
@inject IStringLocalizer<EmployeeTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts
@{
    Layout = null;

    // Die Anmeldemaske liegt ausserhalb des Blazor-Kreises und baut ihr HTML selbst.
    // Sprache und Schreibrichtung stammen deshalb hier ebenfalls aus der
    // Request-Lokalisierung.
    var language = SupportedLanguages.Resolve(CultureInfo.CurrentUICulture.Name);
}
<!DOCTYPE html>
<html lang="@language.CultureCode" dir="@language.TextDirection">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Texts["Login.PageTitle"] – @CommonTexts["App.Name"]</title>
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/localization.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-card">
        <h1 class="login-title">@Texts["Login.Title"]</h1>

        <form method="post">
            @* Antiforgery-Token wird vom Tag Helper automatisch eingefuegt. *@
            <div asp-validation-summary="ModelOnly" class="login-error" role="alert"></div>

            <label class="login-label" asp-for="Input.EmployeeCode">@Texts["Login.EmployeeCode"]</label>
            <input class="login-input"
                   asp-for="Input.EmployeeCode"
                   autocomplete="username"
                   dir="ltr"
                   autofocus
                   required />
            <span asp-validation-for="Input.EmployeeCode" class="login-error"></span>

            <label class="login-label" asp-for="Input.Password">@Texts["Login.Password"]</label>
            <input class="login-input"
                   asp-for="Input.Password"
                   type="password"
                   autocomplete="current-password"
                   dir="ltr"
                   required />
            <span asp-validation-for="Input.Password" class="login-error"></span>

            <button class="login-button" type="submit">@Texts["Login.Submit"]</button>
        </form>

        <a class="login-link" href="/employee/forgot-password">@Texts["Login.ForgotPassword"]</a>

        @* Die Sprachwahl steht auch vor der Anmeldung zur Verfuegung: sonst muesste
           ein Mitarbeiter die Maske in einer Sprache bedienen, die er nicht liest. *@
        <nav class="login-languages" aria-label="@CommonTexts["Language.Choose"]">
            @foreach (var supported in SupportedLanguages.All)
            {
                var isCurrent = supported.CultureCode == language.CultureCode;

                <a href="@ConsulatTermine.UI.Localization.CultureEndpoints.BuildSetCultureUrl(supported.CultureCode, "/employee/login")"
                   lang="@supported.TwoLetterCode"
                   dir="@supported.TextDirection"
                   class="@(isCurrent ? "login-language active" : "login-language")"
                   aria-current="@(isCurrent ? "true" : null)">@supported.NativeName</a>
            }
        </nav>
    </main>
</body>
</html>

@page "/employee/dashboard"
@attribute [Authorize(Policy = AuthorizationPolicies.MitarbeiterZugriff)]
@implements IDisposable

@using ConsulatTermine.Domain.Entities
@using ConsulatTermine.Domain.Enums
@using ConsulatTermine.Application.Interfaces
@using Blazored.SessionStorage

@inject IAppointmentService AppointmentService
@inject IServiceService ServiceService
@inject IEmployeeAuthorization Authorization
@inject IWaitingRoomNotifier WaitingRoomNotifier
@inject ISessionStorageService Session
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<EmployeeTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@CommonTexts["Nav.Dashboard"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    @if (_loading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-8">
            <MudProgressCircular Indeterminate aria-label="@Texts["Dashboard.Loading"]" />
            <MudText>@Texts["Dashboard.Loading"]</MudText>
        </MudStack>
    }
    else
    {
        <MudGrid>

            <!-- LINKS -->
            <MudItem xs="12" md="9">

                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h5" HtmlTag="h1">@Texts["Dashboard.Title", _serviceName]</MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Texts["Dashboard.Workplace", _room, _office, DateTime.Today.ToString("d", CultureInfo.CurrentCulture)]
                    </MudText>
                </MudPaper>

                <MudPaper Class="pa-4 mb-3">
                    <MudStack Row="true" Spacing="2">

                        @* Die Beschriftungen tragen die Bedeutung; die Symbole sind nur
                           Beiwerk und deshalb Icons statt Zeichen im Text. *@
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(!_canNext)"
                                   OnClick="NextAsync">
                            @Texts["Dashboard.Next"]
                        </MudButton>

                        <MudButton Color="Color.Warning"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.NotificationsActive"
                                   Disabled="@(!_hasMyInProgress)"
                                   OnClick="RecallAsync">
                            @Texts["Dashboard.Recall"]
                        </MudButton>

                        <MudButton Color="Color.Info"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.HowToReg"
                                   Disabled="@(!_hasMyInProgress)"
                                   OnClick="ArrivedAsync">
                            @Texts["Dashboard.Arrived"]
                        </MudButton>

                        <MudButton Color="Color.Success"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@(!_hasMyInProgress)"
                                   OnClick="CompleteAsync">
                            @Texts["Dashboard.Complete"]
                        </MudButton>

                    </MudStack>
                </MudPaper>

                <MudTable Items="_appointments" Dense Hover aria-label="@Texts["Dashboard.TableAria"]">
                    <HeaderContent>
                        <MudTh>@Texts["Dashboard.Column.Time"]</MudTh>
                        <MudTh>@Texts["Dashboard.Column.Name"]</MudTh>
                        <MudTh>@Texts["Dashboard.Column.Status"]</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="@Texts["Dashboard.Column.Time"]">
                            @context.Date.ToString("HH:mm", CultureInfo.CurrentCulture)
                        </MudTd>
                        <MudTd DataLabel="@Texts["Dashboard.Column.Name"]">@context.FullName</MudTd>
                        <MudTd DataLabel="@Texts["Dashboard.Column.Status"]">
                            <MudChip T="String" Color="@GetStatusColor(context)" Size="Size.Small">
                                @GetStatusText(context)
                            </MudChip>
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText>@Texts["Dashboard.Empty"]</MudText>
                    </NoRecordsContent>
                </MudTable>

            </MudItem>

            <!-- RECHTS -->
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2">@Texts["Dashboard.Statistics"]</MudText>
                    <MudDivider />
                    <MudText>@Texts["Dashboard.Total", _appointments.Count]</MudText>
                    <MudText>@Texts["Dashboard.Waiting", _appointments.Count(a => a.Status == AppointmentStatus.Booked)]</MudText>
                    <MudText>@Texts["Dashboard.WithMe", _appointments.Count(a =>
                        a.Status == AppointmentStatus.InProgress &&
                        a.CurrentEmployeeId == _employeeId)]</MudText>
                </MudPaper>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@code {
    private bool _loading = true;
    private bool _initialized;
    private bool _disposed;

    private int _employeeId;
    private int _serviceId;

    private string _serviceName = "";
    private string _office = "";
    private string _room = "";

    private List<Appointment> _appointments = new();
    private Appointment? _myInProgress;

    private readonly SemaphoreSlim _sync = new(1, 1);

    // ✅ WAR FEHLEND
    private bool _hasMyInProgress => _myInProgress != null;

    private bool _canNext =>
        _initialized &&
        _myInProgress == null &&
        _appointments.Any(a => a.Status == AppointmentStatus.Booked);

    protected override Task OnInitializedAsync()
    {
        WaitingRoomNotifier.OnChanged += HandleChanged;
        return Task.CompletedTask;
    }

    // ✅ SIGNATUR KORRIGIERT (Reason + AppointmentId)
    private void HandleChanged(WaitingRoomChangeReason _, int? __)
    {
        if (_disposed) return;

    InvokeAsync(async () =>
{
    if (_disposed || !_initialized) return;

    await WithLockAsync(async () =>
    {
        await LoadAsync();
    });

    StateHasChanged();
});

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        var current = await Authorization.RequireEmployeeAsync();
        _employeeId = current.EmployeeId;

        // Der gewählte Arbeitsplatz ist Bedienzustand, keine Berechtigung.
        var activeServiceId = await Session.GetItemAsync<int>(SessionKeys.ActiveServiceId);
        if (activeServiceId <= 0)
        {
            Navigation.NavigateTo("/employee/select-service", true);
            return;
        }

        _serviceId = activeServiceId;

        _office = await Session.GetItemAsync<string>(SessionKeys.OfficeName) ?? "";
        _room = await Session.GetItemAsync<string>(SessionKeys.RoomName) ?? "";

        // Die Bezeichnung wird bei jedem Aufbau neu gelesen statt im Sitzungsspeicher
        // gehalten: nach einem Sprachwechsel stuende dort sonst die alte Fassung.
        var service = await ServiceService.GetByIdAsync(_serviceId);
        _serviceName = service?.NameFor(CultureInfo.CurrentUICulture.Name) ?? string.Empty;

        await WithLockAsync(async () => await LoadAsync());

        _initialized = true;
        _loading = false;

        StateHasChanged();
    }

    private async Task WithLockAsync(Func<Task> work)
    {
        await _sync.WaitAsync();
        try
        {
            if (_disposed) return;
            await work();
        }
        finally
        {
            _sync.Release();
        }
    }

    private async Task LoadAsync()
    {
        _appointments = await AppointmentService
            .GetAppointmentsForServiceOnDateAsync(_serviceId, DateTime.Today);

        _myInProgress = _appointments.FirstOrDefault(a =>
            (a.Status == AppointmentStatus.InProgress ||
             a.Status == AppointmentStatus.AtDesk) &&
            a.CurrentEmployeeId == _employeeId);
    }

    private async Task NextAsync()
    {
        if (!_initialized) return;

        await WithLockAsync(async () =>
        {
            await LoadAsync();

            var next = _appointments
                .Where(a => a.Status == AppointmentStatus.Booked)
                .OrderBy(a => a.Date)
                .FirstOrDefault();

            if (next == null) return;

            var ok = await AppointmentService.StartProcessingAsync(next.Id, _employeeId);
            if (!ok) return;

            WaitingRoomNotifier.SetWorkplace(next.Id, _office, _room);
            WaitingRoomNotifier.Notify(WaitingRoomChangeReason.Call, next.Id);

         
        });

        StateHasChanged();
    }

    private Task RecallAsync()
    {
        if (_myInProgress == null) return Task.CompletedTask;

        WaitingRoomNotifier.Notify(
            WaitingRoomChangeReason.Recall,
            _myInProgress.Id
        );

        return Task.CompletedTask;
    }

    private async Task ArrivedAsync()
    {
        if (_myInProgress == null) return;

        await AppointmentService.HideFromWaitingRoomAsync(
            _myInProgress.Id,
            _employeeId
        );

     
        StateHasChanged();
    }

    private async Task CompleteAsync()
    {
        if (_myInProgress == null) return;

        await AppointmentService.CompleteAsync(
            _myInProgress.Id,
            _employeeId
        );

        WaitingRoomNotifier.Notify();
      
        StateHasChanged();
    }

    // ✅ WAR FEHLEND
    private static Color GetStatusColor(Appointment a) => a.Status switch
    {
        AppointmentStatus.InProgress => Color.Warning,
        AppointmentStatus.AtDesk     => Color.Info,
        AppointmentStatus.Completed  => Color.Success,
        _                            => Color.Default
    };

    // ✅ WAR FEHLEND
    /// <summary>
    /// Beschriftet den Status aus Sicht des angemeldeten Mitarbeiters. Ein Termin,
    /// den er selbst aufgerufen hat, wird eigens benannt; sonst gilt die allgemeine
    /// Bezeichnung des Status.
    /// </summary>
    private string GetStatusText(Appointment appointment)
    {
        if (appointment.CurrentEmployeeId == _employeeId)
        {
            if (appointment.Status == AppointmentStatus.InProgress)
            {
                return Texts["Dashboard.StatusWithMe"];
            }

            if (appointment.Status == AppointmentStatus.AtDesk)
            {
                return Texts["Dashboard.StatusArrived"];
            }
        }

        return appointment.Status.ToDisplayText(CommonTexts);
    }

    public void Dispose()
    {
        _disposed = true;
        WaitingRoomNotifier.OnChanged -= HandleChanged;
        _sync.Dispose();
    }
}

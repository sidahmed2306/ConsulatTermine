@page "/appointment-confirmation"
@attribute [AllowAnonymous]

@using Blazored.SessionStorage

@inject ISessionStorageService Session
@inject NavigationManager Navigation
@inject IStringLocalizer<BookingTexts> Texts

<PageTitle>@Texts["Confirmation.Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto mt-10">

    <BookingStepper ActiveStep="3" />

    <MudCard Class="pa-8" Style="border-radius:14px">

        <MudStack Spacing="3" AlignItems="AlignItems.Center">

            <!-- ICON -->
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Color="Color.Success"
                     Size="Size.Large" />

            <!-- TITLE -->
            <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Success" HtmlTag="h1">
                @Texts["Confirmation.Title"]
            </MudText>

            <!-- TEXT -->
            <MudText Typo="Typo.body1" Align="Align.Center">
                @Texts["Confirmation.Text"]
            </MudText>

            <MudDivider Class="my-4" />

            <!-- BOOKING INFO -->
            @if (!string.IsNullOrWhiteSpace(_bookingReference))
            {
                <MudPaper Class="pa-4" Style="border-radius:10px; width:100%; background:#f9f9f9">

                    <MudText Typo="Typo.subtitle1">
                        <b>@Texts["Confirmation.BookingNumber"]</b>
                    </MudText>

                    @* Die Buchungsnummer ist eine technische Kennung und bleibt auch
                       im arabischen Satz von links nach rechts lesbar. *@
                    <MudText Typo="Typo.h6" Color="Color.Primary" dir="ltr">
                        @_bookingReference
                    </MudText>

                    @if (!string.IsNullOrWhiteSpace(_email))
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">
                            @Texts["Confirmation.EmailSent", _email]
                        </MudText>
                    }
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" role="alert">
                    @Texts["Confirmation.NoReference"]
                </MudAlert>
            }

            <MudDivider Class="my-4" />

            <!-- FOOTER -->
            <MudText Typo="Typo.caption" Align="Align.Center" Style="opacity:.8">
                @Texts["Confirmation.Footer"]
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Class="mt-4"
                       OnClick="GoToHome">
                @Texts["Confirmation.NewBooking"]
            </MudButton>

        </MudStack>

    </MudCard>
</MudContainer>

@code {

    private string? _bookingReference;
    private string? _email;

 protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    _bookingReference = await Session.GetItemAsync<string>(SessionKeys.BookingReference);
    _email = await Session.GetItemAsync<string>(SessionKeys.MainPersonEmail);

    // ❌ Direktzugriff / Reload ohne gültige Buchung
    if (string.IsNullOrWhiteSpace(_bookingReference))
    {
        Navigation.NavigateTo("/services", replace: true);
        return;
    }

    StateHasChanged();
}



    private void GoToHome()
    {
        Navigation.NavigateTo("/services", forceLoad: true);
    }
}

@page "/admin/employees"
@attribute [Authorize(Policy = AuthorizationPolicies.DienstplanVerwalten)]

@using ConsulatTermine.Application.Interfaces
@using ConsulatTermine.Domain.Entities
@using ConsulatTermine.Domain.Enums
@using ConsulatTermine.Application.Exceptions

@inject IEmployeeService EmployeeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<Employees> Logger
@inject IStringLocalizer<AdministrationTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@Texts["Employees.Title"]</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Spacing="2">

        <MudText Typo="Typo.h5" HtmlTag="h1">@Texts["Employees.Title"]</MudText>

        <MudStack Row="true" Justify="Justify.FlexStart">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="NewEmployee">
                @Texts["Employees.New"]
            </MudButton>
        </MudStack>

        <MudTable Items="_employees" Hover Dense aria-label="@Texts["Employees.TableAria"]">

            <HeaderContent>
                <MudTh>@Texts["Employees.Column.Code"]</MudTh>
                <MudTh>@Texts["Employees.Column.Name"]</MudTh>
                <MudTh>@Texts["Employees.Column.Role"]</MudTh>
                <MudTh>@Texts["Employees.Column.Email"]</MudTh>
                <MudTh>@Texts["Employees.Column.Actions"]</MudTh>
            </HeaderContent>

            <RowTemplate>
                @{
                    var displayName = $"{context.FirstName} {context.LastName}";
                }

                <MudTd DataLabel="@Texts["Employees.Column.Code"]">
                    <span dir="ltr">@context.EmployeeCode</span>
                </MudTd>

                <MudTd DataLabel="@Texts["Employees.Column.Name"]">@displayName</MudTd>

                <MudTd DataLabel="@Texts["Employees.Column.Role"]">
                    @context.Role.ToDisplayText(Texts)
                </MudTd>

                <MudTd DataLabel="@Texts["Employees.Column.Email"]">
                    <span dir="ltr">@context.Email</span>
                </MudTd>

                <MudTd DataLabel="@Texts["Employees.Column.Actions"]">
                    @* Icon-Schaltflaechen brauchen einen zugaenglichen Namen, der den
                       betroffenen Datensatz nennt. Siehe harness/uiux.md Abschnitt 12. *@
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   title="@Texts["Employees.EditAria", displayName]"
                                   aria-label="@Texts["Employees.EditAria", displayName]"
                                   OnClick="@(() => EditEmployee(context))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   title="@Texts["Employees.DeleteAria", displayName]"
                                   aria-label="@Texts["Employees.DeleteAria", displayName]"
                                   OnClick="@(() => ConfirmDeleteEmployeeAsync(context))" />
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>@Texts["Employees.Empty"]</MudText>
            </NoRecordsContent>

        </MudTable>

        @if (_editOpen)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.h6" HtmlTag="h2">
                    @(_editId == 0 ? Texts["Employees.New"] : Texts["Employees.Edit"])
                </MudText>

                <MudStack Spacing="2">

                    <MudTextField Label="@Texts["Employees.FirstName"]"
                                  @bind-Value="_model.FirstName"
                                  Required />

                    <MudTextField Label="@Texts["Employees.LastName"]"
                                  @bind-Value="_model.LastName"
                                  Required />

                    <MudTextField Label="@Texts["Employees.Email"]"
                                  @bind-Value="_model.Email"
                                  InputType="InputType.Email"
                                  dir="ltr"
                                  Required />

                    <MudSelect T="EmployeeRole" Label="@Texts["Employees.Role"]" @bind-Value="_model.Role" Required>
                        @foreach (var role in Roles)
                        {
                            <MudSelectItem Value="role">@role.ToDisplayText(Texts)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="CancelEdit">
                            @CommonTexts["Action.Cancel"]
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@_saving"
                                   OnClick="SaveAsync">
                            @CommonTexts["Action.Save"]
                        </MudButton>
                    </MudStack>

                </MudStack>
            </MudPaper>
        }

    </MudStack>
</MudPaper>

@code {
    private static readonly EmployeeRole[] Roles =
    [
        EmployeeRole.Employee,
        EmployeeRole.ServiceChef,
        EmployeeRole.Admin
    ];

    private List<Employee> _employees = [];
    private bool _editOpen;
    private bool _saving;
    private int _editId;
    private EmployeeDto _model = new();

    // Der Zugang zu dieser Seite wird über [Authorize] geprüft; die
    // Anwendungsfälle prüfen die Berechtigung serverseitig zusätzlich.
    protected override async Task OnInitializedAsync()
    {
        _employees = await EmployeeService.GetAllEmployeesAsync();
    }

    private void NewEmployee()
    {
        _model = new EmployeeDto
        {
            Role = EmployeeRole.Employee
        };

        _editId = 0;
        _editOpen = true;
    }

    private void EditEmployee(Employee employee)
    {
        _model = new EmployeeDto
        {
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            Email = employee.Email,
            Role = employee.Role
        };

        _editId = employee.Id;
        _editOpen = true;
    }

    private void CancelEdit()
    {
        _editOpen = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        try
        {
            var isCreate = _editId == 0;
            var displayName = $"{_model.FirstName} {_model.LastName}";

            if (isCreate)
            {
                await EmployeeService.CreateEmployeeAsync(_model);
            }
            else
            {
                await EmployeeService.UpdateEmployeeAsync(_editId, _model);
            }

            _employees = await EmployeeService.GetAllEmployeesAsync();
            _editOpen = false;

            Snackbar.Add(
                isCreate
                    ? Texts["Employees.Created", displayName]
                    : Texts["Employees.Updated", displayName],
                Severity.Success);
        }
        catch (BusinessRuleViolationException ex)
        {
            // Fachliche Ablehnung: die Meldung stammt aus der Anwendungsschicht und
            // ist dort bereits uebersetzt.
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Texts["Employees.SaveFailed"], Severity.Error);
            Logger.LogError(ex, "Der Mitarbeiter {EmployeeId} konnte nicht gespeichert werden.", _editId);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteEmployeeAsync(Employee employee)
    {
        var displayName = $"{employee.FirstName} {employee.LastName}";

        var parameters = new DialogParameters
        {
            ["Title"] = Texts["Employees.DeleteTitle"].Value,
            ["Message"] = Texts["Employees.DeleteMessage", displayName].Value
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            Texts["Employees.DeleteTitle"],
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await DeleteEmployeeAsync(employee);
        }
    }

    private async Task DeleteEmployeeAsync(Employee employee)
    {
        var displayName = $"{employee.FirstName} {employee.LastName}";

        try
        {
            await EmployeeService.DeleteEmployeeAsync(employee.Id);

            _employees = await EmployeeService.GetAllEmployeesAsync();

            Snackbar.Add(Texts["Employees.Deleted", displayName], Severity.Success);
        }
        catch (BusinessRuleViolationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Texts["Employees.DeleteFailed"], Severity.Error);
            Logger.LogError(ex, "Der Mitarbeiter {EmployeeId} konnte nicht geloescht werden.", employee.Id);
        }
    }
}



@page "/appointment"
@attribute [AllowAnonymous]

@using Blazored.SessionStorage
@using ConsulatTermine.Application.Interfaces

@inject ISessionStorageService Session
@inject IAppointmentService AppointmentService
@inject IServiceService ServiceService
@inject NavigationManager Navigation
@inject IStringLocalizer<BookingTexts> Texts
@inject IStringLocalizer<CommonTexts> CommonTexts

<PageTitle>@Texts["Stepper.Slot"]</PageTitle>



<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <!-- STEPPER -->
    <BookingStepper ActiveStep="1" />

    <MudPaper Class="pa-4 slots-paper">


        @if (!_isReady)
        {
            <MudProgressLinear Indeterminate aria-label="@CommonTexts["State.Loading"]" />
            <MudText Class="mt-3">@CommonTexts["State.Loading"]</MudText>
        }
        else
        {
            <MudGrid Spacing="3">

                <!-- LEFT: CALENDAR -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Style="border-radius:12px">

                        @* Solange die Verfuegbarkeit des Monats laedt, ist kein Tag
                           anklickbar. Sonst trifft ein Klick eine unfertige Auskunft
                           und wird wirkungslos verworfen. *@
                        @if (_isMonthLoading)
                        {
                            <MudProgressLinear Indeterminate
                                               Color="Color.Success"
                                               Class="mb-2"
                                               aria-label="@Texts["Slots.CalendarLoading"]" />
                            <MudText Typo="Typo.caption" Class="mb-2 d-block" aria-live="polite">
                                @Texts["Slots.CalendarLoading"]
                            </MudText>
                        }

                        <MudDatePicker
                            PickerVariant="PickerVariant.Static"
                            OpenTo="OpenTo.Date"
                            Color="Color.Success"
                            Date="_selectedDate"
                            DateChanged="@(EventCallback.Factory.Create<DateTime?>(this, HandleDateChanged))"
                            PickerMonthChanged="@(EventCallback.Factory.Create<DateTime?>(this, HandleMonthChanged))"
                            IsDateDisabledFunc="IsDateDisabled" />

                        <MudText Typo="Typo.caption" Class="mt-2" Style="opacity:.8">
                            @Texts["Slots.CalendarHint"]
                        </MudText>

                    </MudPaper>
                </MudItem>

                <!-- RIGHT: SLOTS -->
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-4" Style="border-radius:12px">

                        <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Success" HtmlTag="h1">
                            @Texts["Slots.TitleForService", _currentServiceName]
                        </MudText>

                        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-2">
                            @Texts["Slots.Duration", _currentSlotDuration]
                        </MudText>

                        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4" Color="Color.Success" aria-live="polite">
                            @Texts["Slots.Selected", SelectedCountForCurrentService, _requiredCountForCurrentService]
                            @if (_requiredCountForCurrentService > 1 && SelectedCountForCurrentService < _requiredCountForCurrentService)
                            {
                                <span> @Texts["Slots.StillToSelect", _requiredCountForCurrentService - SelectedCountForCurrentService]</span>
                            }
                        </MudText>

                        @if (_isDayLoading)
                        {
                            <MudProgressLinear Indeterminate
                                               Color="Color.Success"
                                               aria-label="@Texts["Slots.DayLoading"]" />
                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2" aria-live="polite">
                                @Texts["Slots.DayLoading"]
                            </MudText>
                        }
                        else if (_selectedDate == null)
                        {
                            <MudAlert Severity="Severity.Info">
                                @Texts["Slots.ChooseDayFirst"]
                            </MudAlert>
                        }
                        else if (_slots.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">
                                @Texts["Slots.NoneForDay"]
                            </MudAlert>
                        }
                        else
                        {
                            <MudGrid Spacing="2">
                                @foreach (var slot in _slots)
                                {
                                    var slotStart = slot.SlotStart;
                                    var selectedOnThisSlot = GetCount(slotStart);
                                    var remaining = DisplayFreeCapacity(slot); // remaining capacity for this slot
                                    var isSelected = selectedOnThisSlot > 0;

                                    var slotTime = slotStart.ToString("HH:mm", CultureInfo.CurrentCulture);
                                    var isSingleSelection = _requiredCountForCurrentService == 1;

                                    <MudItem xs="6" sm="6" md="6">
                                        @* Bei genau einer benoetigten Person ist die ganze Kachel die
                                           Aktion und deshalb ein Button: nur so ist sie mit der Tastatur
                                           erreichbar. Bei mehreren Personen tragen die beiden
                                           Schaltflaechen die Aktion, die Kachel bleibt reiner Rahmen. *@
                                        @if (isSingleSelection)
                                        {
                                            <button type="button"
                                                    class="@($"slot-pill clickable {(isSelected ? "selected" : "")}")"
                                                    disabled="@(remaining <= 0 && !isSelected)"
                                                    aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                                                    aria-label="@Texts["Slots.SelectAria", slotTime]"
                                                    @onclick="@(() => OnSlotClicked(slot))">

                                                <span class="slot-time-top">@slotTime</span>
                                                <span class="slot-bottom-row">
                                                    <span class="slot-availability">@Texts["Slots.Free", remaining]</span>
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="slot-pill @(isSelected ? "selected" : "")">
                                                <div class="slot-time-top">@slotTime</div>
                                                <div class="slot-bottom-row">
                                                    <span class="slot-availability">@Texts["Slots.Free", remaining]</span>

                                                    <div class="slot-counter-inline">
                                                        <MudIconButton
                                                            Icon="@Icons.Material.Filled.Remove"
                                                            Color="Color.Error"
                                                            Disabled="@(selectedOnThisSlot <= 0)"
                                                            aria-label="@Texts["Slots.DecreaseAria", slotTime]"
                                                            OnClick="@(() => Decrease(slot))" />

                                                        <span class="slot-count" aria-live="polite">@selectedOnThisSlot</span>

                                                        <MudIconButton
                                                            Icon="@Icons.Material.Filled.Add"
                                                            Color="Color.Success"
                                                            Disabled="@(remaining <= 0 || SelectedCountForCurrentService >= _requiredCountForCurrentService)"
                                                            aria-label="@Texts["Slots.IncreaseAria", slotTime]"
                                                            OnClick="@(() => Increase(slot))" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </MudItem>


                                }
                            </MudGrid>
                        }

                        <MudDivider Class="my-4" />

                        <!-- Buttons -->
                        <MudStack Row="true" Spacing="2">

                            <MudButton Variant="Variant.Outlined" OnClick="Back">
                                @CommonTexts["Action.Back"]
                            </MudButton>

                            <MudButton
                                Variant="Variant.Filled"
                                Color="Color.Success"
                                Disabled="@(!CanGoNext)"
                                OnClick="Next">
                                @CommonTexts["Action.Continue"]
                            </MudButton>

                        </MudStack>

                        @if (_servicesOrdered.Count > 1)
                        {
                            <MudText Typo="Typo.caption" Class="mt-3" Style="opacity:.8">
                                @Texts["Slots.ServiceProgress", _serviceIndex + 1, _servicesOrdered.Count]
                            </MudText>
                        }

                    </MudPaper>
                </MudItem>

            </MudGrid>
        }

    </MudPaper>
</MudContainer>

@code {

    // ===========================
    // CONFIG
    // ===========================
    private static readonly TimeSpan BufferTime = TimeSpan.FromMinutes(60);

    // Raster, in dem die Oberflaeche Slots zusammenfasst und anbietet. Es dient
    // am laufenden Tag zugleich als Vorlaufzeit.
    private const int SlotGridMinutes = 30;

    // ===========================
    // READY / INIT
    // ===========================
    private bool _isReady;
    private bool _isMonthLoading;
    private bool _isDayLoading;

    // Session input
    private int _personCount;
    private Dictionary<int, int> _serviceAssignments = new();

    // Service flow
    private List<int> _servicesOrdered = new();
    private int _serviceIndex;

    // Current service meta
    private int _currentServiceId;
    private string _currentServiceName = "";
    private int _currentSlotDuration; // minutes
    private int _requiredCountForCurrentService;

    // Calendar
    private DateOnly _currentMonth; // first day of month
    private DateTime? _selectedDate;

    private Dictionary<DateOnly, bool> _bookableCache = new(); // month cache

    // Slots
    private List<AvailableSlotDto> _slots = new();

    // Allocation: serviceId -> slotStart -> count
    private Dictionary<int, Dictionary<DateTime, int>> _allocations = new();

    // Duration cache (serviceId -> slotDurationMinutes)
    private Dictionary<int, int> _serviceDurationById = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await InitFromSessionAsync();
        _isReady = true;
        StateHasChanged();
    }

    private async Task InitFromSessionAsync()
    {
        _personCount = await Session.GetItemAsync<int>(SessionKeys.PersonCount);
        _serviceAssignments = await Session.GetItemAsync<Dictionary<int, int>>("serviceAssignments")
                              ?? new Dictionary<int, int>();

        if (_serviceAssignments.Count == 0)
        {
            Navigation.NavigateTo("/services");
            return;
        }

        // Deterministic order (IDs asc)
        _servicesOrdered = _serviceAssignments.Keys.OrderBy(x => x).ToList();
        _serviceIndex = 0;

        // init allocations store
        foreach (var sid in _servicesOrdered)
            _allocations[sid] = new Dictionary<DateTime, int>();

        // Start at today month (neutral)
        var now = DateTime.Today;
        _currentMonth = new DateOnly(now.Year, now.Month, 1);

        await LoadCurrentServiceAsync();
        await LoadMonthAvailabilityAsync(_currentMonth);

        // IMPORTANT: do not preselect a day
        _selectedDate = null;
        _slots = new List<AvailableSlotDto>();
    }

    // ===========================
    // SERVICE STEP
    // ===========================
    private async Task LoadCurrentServiceAsync()
    {
        _currentServiceId = _servicesOrdered[_serviceIndex];
        _requiredCountForCurrentService = _serviceAssignments[_currentServiceId];

        // Use existing IServiceService method
        var dto = await ServiceService.GetByIdAsync(_currentServiceId);

        _currentServiceName = dto.NameFor(CultureInfo.CurrentUICulture.Name);
        _currentSlotDuration = dto.SlotDurationMinutes;

        // cache duration
        _serviceDurationById[_currentServiceId] = _currentSlotDuration;

        // ✅ Service-Wechsel darf kein Datum erzwingen
        _selectedDate = null;
        _slots.Clear();
    }

    // ===========================
    // DATE PICKER EVENTS
    // ===========================
    private async Task HandleMonthChanged(DateTime? date)
    {
        if (!date.HasValue) return;

        // Ein zweiter Wechsel waehrend des Ladens wuerde den halb gefuellten
        // Stand des ersten ueberschreiben.
        if (_isMonthLoading) return;

        _currentMonth = new DateOnly(date.Value.Year, date.Value.Month, 1);

        _selectedDate = null;
        _slots.Clear();

        await LoadMonthAvailabilityAsync(_currentMonth);

        StateHasChanged();
    }
    private void OnSlotClicked(AvailableSlotDto slot)
{
    // Nur bei 1 Person
    if (_requiredCountForCurrentService != 1)
        return;

    // Nicht klickbar, wenn kein Platz frei
    var remaining = DisplayFreeCapacity(slot);
    if (remaining <= 0)
        return;

    // Deine bestehende Logik weiter nutzen
    SelectSingleSlot(slot);

    // 🔥 wichtig: UI neu rendern
    StateHasChanged();
}


    private async Task HandleDateChanged(DateTime? date)
    {
        // Waehrend der Monat laedt, ist kein Tag anklickbar; ein Ereignis aus
        // dieser Zeit beruht auf einem unfertigen Stand.
        if (_isMonthLoading) return;

        _selectedDate = date;

        if (!_selectedDate.HasValue)
        {
            _slots.Clear();
            StateHasChanged();
            return;
        }

        var day = DateOnly.FromDateTime(_selectedDate.Value);

        // Die Auswahl wird bewusst nicht mehr zurueckgesetzt. Ein Zuruecksetzen
        // wirkte auf den Kalender zurueck, loeste ein zweites Ereignis aus und
        // verwarf den Klick ohne erkennbaren Grund. Liefert der Tag nichts,
        // sagt die Slot-Liste das jetzt selbst.
        _isDayLoading = true;
        StateHasChanged();

        try
        {
            await LoadSlotsForSelectedDayAsync(day);
        }
        finally
        {
            _isDayLoading = false;
        }

        StateHasChanged();
    }

    private bool IsDateDisabled(DateTime date)
    {
        if (_isMonthLoading)
            return true;

        if (date.Date < DateTime.Today)
            return true;

        var d = DateOnly.FromDateTime(date);
        return !_bookableCache.TryGetValue(d, out var ok) || !ok;
    }

    // ===========================
    // BACKEND LOADS
    // ===========================
    /// <summary>
    /// Ermittelt, welche Tage des Monats buchbar sind.
    /// </summary>
    /// <remarks>
    /// Ein Tag gilt genau dann als buchbar, wenn fuer ihn dieselbe Berechnung
    /// mindestens einen Slot liefert, die auch die Slot-Liste fuellt. Vorher
    /// entschied der Kalender nach einer eigenen, grosszuegigeren Regel, sodass
    /// ein anklickbarer Tag leer bleiben konnte.
    ///
    /// Der Zwischenstand wird lokal aufgebaut und erst am Ende uebernommen. Der
    /// Kalender sieht damit nie eine halb gefuellte Auskunft.
    /// </remarks>
    private async Task LoadMonthAvailabilityAsync(DateOnly monthFirstDay)
    {
        _isMonthLoading = true;
        StateHasChanged();

        try
        {
            var slotsByDay = await AppointmentService.GetAvailableSlotDtosForMonthAsync(
                _currentServiceId,
                monthFirstDay);

            var otherSelected = BuildOtherSelectedSlotsForCompatibility();
            var today = DateOnly.FromDateTime(DateTime.Today);
            var now = DateTime.Now;

            var bookable = new Dictionary<DateOnly, bool>();

            foreach (var (day, slotsOfDay) in slotsByDay)
            {
                bookable[day] = day >= today
                    && AppointmentCalculator.GetSelectableSlots(
                        slotsOfDay,
                        day,
                        _currentSlotDuration,
                        otherSelected,
                        BufferTime,
                        SlotGridMinutes,
                        now).Count > 0;
            }

            _bookableCache = bookable;
        }
        finally
        {
            _isMonthLoading = false;
        }
    }

    private async Task LoadSlotsForSelectedDayAsync(DateOnly day)
    {
        // Der Tag wird frisch geladen: zwischen dem Aufbau des Kalenders und der
        // Auswahl kann jemand anders gebucht haben.
        var raw = await AppointmentService.GetAvailableSlotDtosAsync(
            _currentServiceId,
            day.ToDateTime(TimeOnly.MinValue));

        _slots = AppointmentCalculator.GetSelectableSlots(
            raw,
            day,
            _currentSlotDuration,
            BuildOtherSelectedSlotsForCompatibility(),
            BufferTime,
            SlotGridMinutes,
            DateTime.Now);
    }

    // Builds list of other selected slots as (Start, DurationMinutes)
    private List<(DateTime Start, int DurationMinutes)> BuildOtherSelectedSlotsForCompatibility()
    {
        var list = new List<(DateTime Start, int DurationMinutes)>();

        foreach (var sid in _servicesOrdered)
        {
            if (sid == _currentServiceId)
                continue;

            if (!_serviceDurationById.TryGetValue(sid, out var dur))
                continue;

            var map = _allocations[sid];

            foreach (var kvp in map)
            {
                var slotStart = kvp.Key;
                var count = kvp.Value;

                if (count <= 0) continue;

                for (int i = 0; i < count; i++)
                    list.Add((slotStart, dur));
            }
        }

        return list;
    }

    // ===========================
    // SLOT SELECTION LOGIC
    // ===========================
    private int SelectedCountForCurrentService
        => _allocations[_currentServiceId].Values.Sum();

    private bool IsSelected(DateTime slotStart)
        => _allocations[_currentServiceId].TryGetValue(slotStart, out var c) && c > 0;

    private int GetCount(DateTime slotStart)
        => _allocations[_currentServiceId].TryGetValue(slotStart, out var c) ? c : 0;

    private int DisplayFreeCapacity(AvailableSlotDto slot)
    {
        // remaining = backend free - already selected on same slot (this service)
        var selectedOnThisSlot = GetCount(slot.SlotStart);
        return Math.Max(0, slot.FreeCapacity - selectedOnThisSlot);
    }

 private void SelectSingleSlot(AvailableSlotDto slot)
{
    var map = _allocations[_currentServiceId];
    map.Clear();
    map[slot.SlotStart] = 1;

    StateHasChanged();
}

    private void Increase(AvailableSlotDto slot)
    {
        var map = _allocations[_currentServiceId];
        var current = GetCount(slot.SlotStart);
        var remaining = DisplayFreeCapacity(slot);

        if (SelectedCountForCurrentService >= _requiredCountForCurrentService) return;
        if (remaining <= 0) return;                 // ✅ FIX: only block when slot is actually full

        map[slot.SlotStart] = current + 1;
    }

    private void Decrease(AvailableSlotDto slot)
    { 
        var map = _allocations[_currentServiceId];
        var current = GetCount(slot.SlotStart);
        if (current <= 0) return;

        var next = current - 1;
        if (next == 0) map.Remove(slot.SlotStart);
        else map[slot.SlotStart] = next;
    }

    // ===========================
    // NAVIGATION
    // ===========================
    private bool CanGoNext
        => SelectedCountForCurrentService == _requiredCountForCurrentService;

    private void Back()
    {
        if (_serviceIndex > 0)
        {
            _serviceIndex--;
            _ = GoToServiceIndexAsync(_serviceIndex);
        }
        else
        {
            Navigation.NavigateTo("/services");
        }
    }

    private async Task Next()
    {
        if (!CanGoNext)
            return;

        await SaveSelectionsToSessionAsync();

        if (_serviceIndex < _servicesOrdered.Count - 1)
        {
            _serviceIndex++;
            await GoToServiceIndexAsync(_serviceIndex);
        }
        else
        {
            Navigation.NavigateTo("/appointment-form");
        }
    }

    private async Task GoToServiceIndexAsync(int index)
    {
        _serviceIndex = index;

        await LoadCurrentServiceAsync();

        await LoadMonthAvailabilityAsync(_currentMonth);

        _selectedDate = null;
        _slots.Clear();

        StateHasChanged();
    }

    private async Task SaveSelectionsToSessionAsync()
    {
        // Expand allocations into serviceId -> List<DateTime> (repeated per person)
        var expanded = new Dictionary<int, List<DateTime>>();

        foreach (var sid in _servicesOrdered)
        {
            var list = new List<DateTime>();
            foreach (var kv in _allocations[sid].OrderBy(x => x.Key))
            {
                for (int i = 0; i < kv.Value; i++)
                    list.Add(kv.Key);
            }
            expanded[sid] = list;
        }

        await Session.SetItemAsync(SessionKeys.SelectedServiceSlots, expanded);
    }
}
@page
@model ConsulatTermine.UI.Pages.ErrorModel
@inject IStringLocalizer<CommonTexts> Texts
@{
    // Die Fehlerseite liegt ausserhalb der Blazor-Anwendung und baut ihr HTML selbst.
    var language = SupportedLanguages.Resolve(CultureInfo.CurrentUICulture.Name);
}
<!DOCTYPE html>
<html lang="@language.CultureCode" dir="@language.TextDirection">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Texts["Error.PageTitle"] – @Texts["App.Name"]</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/localization.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>

<body>
    <main class="main">
        <div class="content px-4">
            <h1 class="text-danger">@Texts["Error.Heading"]</h1>

            <p>@Texts["Error.Message"]</p>

            @if (Model.ShowRequestId)
            {
                @* Die Vorgangsnummer erlaubt es dem Support, den Fehler im Log
                   wiederzufinden. Sie enthaelt selbst keine Einzelheiten des Fehlers. *@
                <p>
                    <strong>@Texts["Error.RequestId"]:</strong>
                    <code dir="ltr">@Model.RequestId</code>
                </p>
            }

            <p>
                <a href="/">@Texts["Error.BackToStart"]</a>
            </p>
        </div>
    </main>
</body>

</html>
